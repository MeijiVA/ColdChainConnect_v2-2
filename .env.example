# Database
DATABASE_URL=postgresql://user:password@localhost:5432/coldchain

# Authentication
JWT_SECRET=your-secret-key-here

# Gemini (Sales Forecast assistant)
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=optional-model-override

# Server
NODE_ENV=development
PORT=8080

# Ping test (optional)
PING_MESSAGE=pong

# Demo deployment only (leave unset on the real app).
# Turns on POST /api/auth/demo-login so the sign-in screen can offer a Staff / Agent picker with no password.
# Point DATABASE_URL at a demo database, never at real customer data.
# DEMO_ROLE_PICKER=true
# DEMO_STAFF_USERNAME=demo-staff   # created on first use with every module enabled
# DEMO_AGENT_USERNAME=agent1       # must already exist (pnpm db:seed creates agent1-3)
